          "response": []
        },
        {
          "name": "Get All Vendors (Including Pending)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "vendors"
              ]
            },
            "description": "Fetch all vendors including pending registrations (Admin only)"
          },
          "response": []
        },
        {
          "name": "✅ Approve Vendor (Activate Account)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/vendor-approve/{{vendorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "vendor-approve",
                "{{vendorId}}"
              ]
            },
            "description": "Admin approves a vendor account. After approval, vendor can login. Use vendorId from Get All Vendors response"
          },
          "response": []
        },
        {
          "name": "❌ Reject Vendor (Deny Account)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/vendor-reject/{{vendorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "vendor-reject",
                "{{vendorId}}"
              ]
            },
            "description": "Admin rejects a vendor account. Rejected vendors cannot login. Use vendorId from Get All Vendors response"
          },
          "response": []
        }
      ]
    },
