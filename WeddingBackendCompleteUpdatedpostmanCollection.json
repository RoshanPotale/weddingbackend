  "item": [
    {
      "name": "📝 REGISTRATION - New User Signup",
      "item": [
        {
          "name": "1️⃣ Admin Registration (First Setup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@wedding.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin-register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "admin-register"
              ]
            },
            "description": "Register the first admin (one-time setup). Save the token to {{adminToken}} variable for future admin operations"
          },
          "response": []
        },
        {
          "name": "2️⃣ User Registration (Public - Global)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Singh\",\n  \"email\": \"rahul.user@wedding.com\",\n  \"password\": \"UserPass123\",\n  \"phone\": \"9876543210\",\n  \"city\": \"Mumbai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user-register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user-register"
              ]
            },
            "description": "Public user registration - Anyone can register as a customer. No approval needed. Save the token to {{userToken}} variable"
          },
          "response": []
        },
        {
          "name": "3️⃣ Vendor Registration (Website - Pending Approval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Royal Photography Studio\",\n  \"ownerName\": \"Anil Verma\",\n  \"email\": \"royal.photo@wedding.com\",\n  \"password\": \"VendorPass123\",\n  \"phone\": \"8765432100\",\n  \"whatsapp\": \"8765432100\",\n  \"address\": \"123 Wedding Street, Photography Lane\",\n  \"city\": \"Mumbai\",\n  \"category\": \"Photography\",\n  \"experience\": \"10\",\n  \"teamSize\": \"5\",\n  \"description\": \"Professional wedding photography with drone coverage\",\n  \"pricingRange\": \"50000-200000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/vendor-register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "vendor-register"
              ]
            },
            "description": "Vendor direct registration from website. Status: PENDING (awaits admin approval). Vendor CANNOT login until admin approves. After approval, vendor can login using vendor-login endpoint."
          },
          "response": []
        }
      ]
    },
