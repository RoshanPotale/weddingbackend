{
  "info": {
    "name": "Wedding Backend - Vendor Booking Management",
    "description": "Complete Booking Management API endpoints for vendors",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "wedding-booking-management",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "vendorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📋 Booking CRUD Operations",
      "item": [
        {
          "name": "1. Create New Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingDate\": \"2026-06-15\",\n  \"customerName\": \"Rohit Kumar\",\n  \"contactNumber\": \"9876543210\",\n  \"bookingFrom\": \"direct_customer\",\n  \"bookingAmount\": 50000,\n  \"eventDate\": \"2026-07-20\",\n  \"eventLocation\": \"Delhi Convention Center\",\n  \"notes\": \"Premium catering service required\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings"]
            },
            "description": "Create a new booking for a customer. After creation, copy the booking ID and save to {{bookingId}} variable."
          },
          "response": []
        },
        {
          "name": "2. Get All Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings"]
            },
            "description": "Retrieve all bookings for the vendor (sorted by date, latest first)"
          },
          "response": []
        },
        {
          "name": "3. Get Booking Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "{{bookingId}}"]
            },
            "description": "Get detailed information about a specific booking"
          },
          "response": []
        },
        {
          "name": "4. Update Booking",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Rohit Kumar\",\n  \"contactNumber\": \"9876543210\",\n  \"bookingAmount\": 55000,\n  \"eventDate\": \"2026-07-25\",\n  \"eventLocation\": \"Mumbai Convention Center\",\n  \"notes\": \"Updated to premium service\",\n  \"bookingStatus\": \"upcoming\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "{{bookingId}}"]
            },
            "description": "Update booking details. Remaining amount auto-calculates if booking amount is updated."
          },
          "response": []
        },
        {
          "name": "5. Delete Booking",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "{{bookingId}}"]
            },
            "description": "Delete a booking from the system"
          },
          "response": []
        }
      ]
    },
    {
      "name": "💳 Payment Management",
      "item": [
        {
          "name": "1. Add Payment to Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaid\": 15000,\n  \"paymentMethod\": \"bank_transfer\",\n  \"transactionId\": \"TXN123456\",\n  \"notes\": \"Advance payment received\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/{{bookingId}}/payment",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "{{bookingId}}", "payment"]
            },
            "description": "Record a payment against a booking. System automatically calculates remaining amount and updates payment status. Payment amount cannot exceed remaining booking amount."
          },
          "response": []
        },
        {
          "name": "2. Get Payment History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/{{bookingId}}/payment-history",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "{{bookingId}}", "payment-history"]
            },
            "description": "Get complete payment history for a booking including all transactions and summary statistics"
          },
          "response": []
        }
      ]
    },
    {
      "name": "📊 Statistics",
      "item": [
        {
          "name": "Get Booking Statistics Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor/bookings/stats/summary",
              "host": ["{{baseUrl}}"],
              "path": ["vendor", "bookings", "stats", "summary"]
            },
            "description": "Get comprehensive booking and payment statistics including totals, counts by status, and payment breakdown"
          },
          "response": []
        }
      ]
    }
  ]
}
